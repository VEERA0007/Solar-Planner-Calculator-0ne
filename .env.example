# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Universal Solar Inverter Cloud API Credentials (Server-Side Only)
# Configure only the variables for your installed inverter brand in AI Studio
# Secrets. Never expose these keys in client code or browser storage.
# ------------------------------------------------------------------------------

# Solarman Open API (Deye, V-Sole, KSolare, Sofar, Havells, Polycab)
INVERTER_SOLARMAN_APP_ID=""
INVERTER_SOLARMAN_APP_SECRET=""
INVERTER_SOLARMAN_USERNAME=""
INVERTER_SOLARMAN_PASSWORD=""
INVERTER_SOLARMAN_API_BASE="https://globalapi.solarmanpv.com"

# SolisCloud API (HMAC-SHA1 signed API Key)
INVERTER_SOLIS_KEY_ID=""
INVERTER_SOLIS_KEY_SECRET=""
INVERTER_SOLIS_API_BASE="https://www.soliscloud.com:13333"

# Growatt ShineServer OpenAPI
INVERTER_GROWATT_API_TOKEN=""
INVERTER_GROWATT_API_BASE="https://openapi.growatt.com"

# Sungrow iSolarCloud API
INVERTER_SUNGROW_APP_KEY=""
INVERTER_SUNGROW_ACCESS_KEY=""
INVERTER_SUNGROW_TOKEN=""
INVERTER_SUNGROW_API_BASE="https://gateway.isolarcloud.com.hk"

# GoodWe SEMS Portal
INVERTER_GOODWE_ACCOUNT=""
INVERTER_GOODWE_PASSWORD=""

# Fronius Solar.web Query API
INVERTER_FRONIUS_ACCESS_KEY_ID=""
INVERTER_FRONIUS_ACCESS_KEY_VALUE=""

# Enphase Enlighten API v4
INVERTER_ENPHASE_API_KEY=""
INVERTER_ENPHASE_ACCESS_TOKEN=""

# Custom JSON / Home Assistant / Local Bridge Endpoint (HTTPS)
INVERTER_CUSTOM_BRIDGE_URL=""
INVERTER_CUSTOM_BRIDGE_TOKEN=""

